# Copie para .env (raiz) — nunca commite o .env.
# Valores abaixo apontam para o Supabase local (`supabase start` / `supabase status`).

# ---------- Backend (FastAPI) ----------
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# Segredo HS256 do Supabase local (JWT_SECRET em `supabase status`). Em produção prefira JWKS e deixe vazio.
SUPABASE_JWT_SECRET=
# UUID do ÚNICO usuário autorizado (gerado por `uv run python -m app.cli create-owner`).
OWNER_SUBJECT=
# Somente servidor/CLI — usado apenas para criar o proprietário. Nunca exponha ao frontend.
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_TIMEZONE=America/Fortaleza

# ---------- Frontend (Vite) — apenas valores públicos ----------
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
